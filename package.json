{
  "name": "book-publishing-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-store book publishing platform with Medusa.js backend and Next.js frontend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn dev:backend\" \"yarn dev:web\"",
    "dev:backend": "cd apps/backend && yarn dev",
    "dev:web": "cd apps/web && yarn dev",
    "build": "yarn build:backend && yarn build:web",
    "build:backend": "cd apps/backend && yarn build",
    "build:web": "cd apps/web && yarn build",
    "start": "concurrently \"yarn start:backend\" \"yarn start:web\"",
    "start:backend": "cd apps/backend && yarn start",
    "start:web": "cd apps/web && yarn start",
    "lint": "yarn lint:backend && yarn lint:web",
    "lint:backend": "cd apps/backend && yarn lint",
    "lint:web": "cd apps/web && yarn lint",
    "test": "yarn test:backend && yarn test:web",
    "test:backend": "cd apps/backend && yarn test",
    "test:web": "cd apps/web && yarn test",
    "clean": "rm -rf apps/backend/node_modules apps/web/node_modules packages/*/node_modules .next node_modules",
    "install:all": "yarn install"
  },
  "resolutions": {
    "webpack": "5.88.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "packageManager": "yarn@3.6.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.6",
    "@medusajs/cache-inmemory": "^1.8.11",
    "@medusajs/event-bus-local": "^1.9.9",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "regenerator-runtime": "^0.14.1"
  }
}
